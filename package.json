{
  "name": "@neptune810/dsh-model-router",
  "version": "0.17.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Model router for DeepSeek Harness: keep a pool of models and every step is routed to one of them with its reasoning effort set — a click-only composer panel, three authorization scopes (a manual pick only counts in the scope that owns it, and effort scope is bound to the one model you choose), task presets with per-model weights, vision routing for image steps, session signals (todo, context pressure, token budget, subagents) and an optional semantic task classifier. Thinking stays on, because DeepSeek rejects a tool call made with thinking off.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./policy": "./lib/policy.js",
    "./routing": "./lib/routing.js",
    "./config": "./lib/config.js",
    "./client": "./client/client.js",
    "./catalog-pricing": "./lib/catalog-pricing.js",
    "./effort": "./lib/effort.js",
    "./channels": "./lib/channels.js",
    "./budget": "./lib/budget.js",
    "./replay": "./lib/replay.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-model-router-replay": "./lib/replay.js"
  },
  "files": [
    "lib/",
    "client/",
    "catalog/",
    "schema/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "docs/ui-preview.html",
    "docs/preview-dark.png",
    "docs/preview-light.png",
    "docs/preview-background.png",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:gate": "node scripts/gate.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:gate": "node scripts/check-release.mjs --pack",
    "replay": "node lib/replay.js"
  },
  "dsh": {
    "compat": {
      "dsh": ">=0.1.7-rc.2 <0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "plugin",
    "cordis",
    "model-router",
    "reasoning-effort",
    "flash",
    "routing",
    "model-pool",
    "task-presets",
    "vision-routing",
    "composer-ui",
    "task-classifier"
  ],
  "author": "Neptune810",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neptune810/dsh-model-router.git"
  },
  "homepage": "https://github.com/Neptune810/dsh-model-router#readme",
  "bugs": {
    "url": "https://github.com/Neptune810/dsh-model-router/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.2 <0.2.0"
  }
}
